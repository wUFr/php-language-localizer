{
	"name": "wufr/php-language-localizer",
	"description": "Translate keys into text values based on set language",
	"type": "library",
	"license": "MIT",
	"keywords": ["i18n", "l10n", "translation", "localization", "pluralization", "cldr"],
	"authors": [
		{
			"name": "Jiří Bělský",
			"email": "packages@jiribelsky.cz"
		}
	],
	"support": {
		"issues": "https://github.com/wUFr/php-language-localizer/issues",
		"source": "https://github.com/wUFr/php-language-localizer",
		"security": "https://github.com/wUFr/php-language-localizer/blob/release/SECURITY.md"
	},
	"require": {
		"php": "^8.1"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
	},
	"suggest": {
		"ext-intl": "Locale-aware {value, number} and {value, date} placeholders"
	},
	"autoload": {
		"psr-4": {
			"wUFr\\": "src/"
		}
	},
	"config": {
		"sort-packages": true
	},
	"scripts": {
		"test": "phpunit",
		"analyse": "phpstan analyse --no-progress"
	}
}
